{
  "name": "dsh-agy-native",
  "version": "0.2.1",
  "description": "TOS-safe native DeepSeek Harness LLM adapter for Google AI Pro/Ultra subscriptions via the official Antigravity CLI (agy acp)",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-agy-native": "dist/cli.js"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.mjs",
    "test:live": "npm run build && DSH_AGY_LIVE_TEST=1 node --test --test-concurrency=1 test/live-agy.test.mjs",
    "doctor": "npm run build && node dist/cli.js doctor",
    "prepack": "npm run build",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/cosmokit": "^1.8.0",
    "@deepseek-ai/dsh-attachment": ">=0.2.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-0",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-attachment": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/cosmokit": "1.9.0",
    "@deepseek-ai/dsh-attachment": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "3.19.0",
    "@types/node": "^22.13.0",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weijiafu14/dsh-agy-native.git"
  },
  "homepage": "https://github.com/weijiafu14/dsh-agy-native#readme",
  "bugs": {
    "url": "https://github.com/weijiafu14/dsh-agy-native/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "antigravity",
    "agy",
    "acp",
    "gemini",
    "claude",
    "mcp",
    "cordis"
  ],
  "author": "weijiafu14"
}
